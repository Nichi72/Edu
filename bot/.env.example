# 이 파일을 .env 로 복사해 채운다. .env 는 git 에 안 들어간다.

# 디스코드 개발자 포털 → Bot → Reset Token
DISCORD_TOKEN=

# 서버 ID 는 안 적는다. 봇을 초대한 서버가 곧 수업이다 (서버 하나 = 수업 하나).
# 서버마다 이 이름의 채널이 선생님 채널(#채점실). 없으면 봇이 비공개로 만든다
GRADING_CHANNEL=채점실

# 선생님 디스코드 ID (여럿이면 쉼표). 비우면 #채점실에 글을 쓸 수 있는 사람은 다 명령 가능
# (디스코드 설정 → 고급 → 개발자 모드 → 내 프로필 우클릭 → ID 복사)
TEACHER_IDS=

# 이 컴의 이름. 두 컴에서 서로 다르게 (교탁컴 / 집컴). 동시 실행 잠금에 쓴다
INSTANCE=집컴

# 구글 시트 (비우면 로컬 기록만). 수업이 여러 개여도 시트는 하나 — 「수업」 열로 나뉜다
# 시트 URL 의 /d/ 와 /edit 사이 글자
SHEET_ID=
# 서비스 계정 키 JSON 파일 경로. 시트를 그 계정 이메일에 편집자로 공유해야 한다
GOOGLE_SA_JSON=

# 켜질 때 며칠 치 DM 을 거슬러 올라가 밀린 제출을 찾을지
CATCHUP_DAYS=14
